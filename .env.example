# ============================================================
# .env.example - copy to .env and fill in real values.
# Never commit .env.
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (local Docker SQL Server) ---
# Used by docker-compose to set the SA password
MSSQL_SA_PASSWORD=<your-strong-sql-password>
DB_NAME=FeeManagement
# Single connection string used by the app and scripts.
# Password must match MSSQL_SA_PASSWORD above.
AZURE_SQL_CONNECTIONSTRING="Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=FeeManagement;Uid=sa;Pwd=<your-strong-sql-password>;Encrypt=yes;TrustServerCertificate=yes;"

# --- Authentication ---
# mock = local testing only (reads X-Mock-Roles header)
# jwt  = validates real Microsoft Entra ID tokens
AUTH_MODE=mock
# Needed only when AUTH_MODE=jwt (fill in after Azure setup)
TENANT_ID=
API_AUDIENCE=

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SENDER_EMAIL=billing@university.edu
SENDER_NAME=Student Accounts Office

# --- Monitoring (leave empty locally; set in Azure) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
