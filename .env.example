# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# DO NOT commit the .env file with real credentials or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database Settings (SQL Server 2022 / Azure SQL Database)
# ------------------------------------------------------------------------------
# Local Docker SQL Server defaults:
DB_SERVER=localhost,1433
DB_NAME=StudentFeeManagementDB
DB_USER=sa
DB_PASSWORD=<your-strong-sql-password-placeholder>
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=yes

# Combined connection string (alternative to discrete fields):
# For Local SQL Server:
# AZURE_SQL_CONNECTIONSTRING="Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=StudentFeeManagementDB;Uid=sa;Pwd=<your-strong-sql-password-placeholder>;TrustServerCertificate=yes;"
# For Azure SQL (Managed Identity / Entra ID):
# AZURE_SQL_CONNECTIONSTRING="Server=tcp:<azure-sql-server-name>.database.windows.net,1433;Database=StudentFeeManagementDB;Authentication=Active Directory Default;Encrypt=True;"
AZURE_SQL_CONNECTIONSTRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=StudentFeeManagementDB;Uid=sa;Pwd=<your-strong-sql-password-placeholder>;TrustServerCertificate=yes;

# ------------------------------------------------------------------------------
# Authentication / JWT Settings (Mock or Azure Entra ID / B2C)
# ------------------------------------------------------------------------------
AUTH_MODE=JWT # Options: JWT, AZURE_AD, API_KEY
JWT_SECRET_KEY=<generate-a-strong-secret-key-32-chars-minimum>
JWT_ALGORITHM=HS256
JWT_ISSUER=fee-management-service
JWT_AUDIENCE=fee-management-client
JWT_EXPIRATION_MINUTES=60

# Azure AD / Entra ID settings (if AUTH_MODE=AZURE_AD)
AZURE_TENANT_ID=<your-azure-tenant-id>
AZURE_CLIENT_ID=<your-azure-client-id>
AZURE_CLIENT_SECRET=<your-azure-client-secret>

# ------------------------------------------------------------------------------
# Email / SMTP Settings (Mailpit for local dev, SendGrid / O365 for Azure)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SENDER_EMAIL=billing@university.edu
SENDER_NAME=Student Accounts Office

# ------------------------------------------------------------------------------
# Logic App / APIM / External Integrations
# ------------------------------------------------------------------------------
LOGIC_APP_REMINDER_TRIGGER_URL=https://<logic-app-name>.azurewebsites.net/api/<workflow-name>/triggers/manual/invoke?api-version=2022-05-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=<signature-placeholder>
APIM_GATEWAY_URL=https://<apim-instance-name>.azure-api.net/fee-management
APIM_SUBSCRIPTION_KEY=<your-apim-subscription-key-placeholder>

# ------------------------------------------------------------------------------
# Azure Monitoring & Diagnostics
# ------------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

