<!--
    Global APIM Policy Placeholder
    Applied at the APIM Service Level across all published APIs.
-->
<policies>
    <inbound>
        <!-- Standard CORS Handling -->
        <cors allow-credentials="true">
            <allowed-origins>
                <origin>https://portal.university.edu</origin>
                <origin>http://localhost:3000</origin>
            </allowed-origins>
            <allowed-methods preflight-result-max-age="300">
                <method>GET</method>
                <method>POST</method>
                <method>PUT</method>
                <method>DELETE</method>
                <method>OPTIONS</method>
            </allowed-methods>
            <allowed-headers>
                <header>Authorization</header>
                <header>Content-Type</header>
                <header>Ocp-Apim-Subscription-Key</header>
                <header>X-Correlation-Id</header>
            </allowed-headers>
            <expose-headers>
                <header>X-Correlation-Id</header>
            </expose-headers>
        </cors>

        <!-- Global Rate Limiting: 100 calls per minute per client IP -->
        <rate-limit-by-key calls="100" renewal-period="60" counter-key="@(context.Request.IpAddress)" />

        <!-- Correlation ID Injection -->
        <choose>
            <when condition="@(!context.Request.Headers.ContainsKey(&quot;X-Correlation-Id&quot;))">
                <set-header name="X-Correlation-Id" exists-action="override">
                    <value>@(Guid.NewGuid().ToString())</value>
                </set-header>
            </when>
        </choose>
    </inbound>
    <backend>
        <forward-request timeout="30" />
    </backend>
    <outbound>
        <!-- Strip backend server signatures for security hardening -->
        <set-header name="Server" exists-action="delete" />
        <set-header name="X-Powered-By" exists-action="delete" />
        <set-header name="X-AspNet-Version" exists-action="delete" />
    </outbound>
    <on-error>
        <base />
        <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
        </set-header>
        <set-body>@{
            return new Newtonsoft.Json.Linq.JObject(
                new Newtonsoft.Json.Linq.JProperty("error", new Newtonsoft.Json.Linq.JObject(
                    new Newtonsoft.Json.Linq.JProperty("code", context.Response.StatusCode),
                    new Newtonsoft.Json.Linq.JProperty("message", context.LastError.Message),
                    new Newtonsoft.Json.Linq.JProperty("correlationId", context.Variables.GetValueOrDefault<string>("X-Correlation-Id", ""))
                ))
            ).ToString();
        }</set-body>
    </on-error>
</policies>

